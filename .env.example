# =============================================================================
# TalentOS Recruiter AI Platform - Environment Configuration
# =============================================================================

# 1. Supabase Client Configuration (Frontend)
# Found in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Server-Side Configuration (Backend)
# NEVER expose the service role key to the browser/frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Supabase Direct PostgreSQL Connection (Backend SQLAlchemy)
# Found in Supabase Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
# Or for Session Pooling (port 5432) or Transaction Pooling (port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 4. Google Gemini API Key (for LLM resume parsing and AI recruiter agent)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Allowed CORS Origins (comma-separated list for Vite dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
